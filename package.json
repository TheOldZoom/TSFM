{
  "name": "@theoldzoom/tsfm",
  "version": "0.1.4",
  "description": "A Last.fm CLI built with TypeScript and Bun",
  "keywords": [
    "lastfm",
    "last.fm",
    "cli",
    "music",
    "scrobble",
    "scrobbling",
    "statistics",
    "terminal",
    "typescript",
    "bun"
  ],
  "homepage": "https://github.com/TheOldZoom/tsfm",
  "bugs": {
    "url": "https://github.com/TheOldZoom/tsfm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheOldZoom/tsfm.git"
  },
  "author": {
    "name": "Zoom",
    "email": "theoldzoom@proton.me",
    "url": "https://zoomhub.xyz"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "tsfm": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "rm -rf dist && bun build ./src/cli.ts --outdir ./dist --target node",
    "start": "node dist/cli.js",
    "prepublishOnly": "bun run build",
    "docs": "bun run scripts/genDocs.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "sharp": "^0.35.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
