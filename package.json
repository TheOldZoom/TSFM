{
  "name": "@theoldzoom/tsfm",
  "version": "0.1.3",
  "description": "A Last.fm CLI built with TypeScript",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "tsfm": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "rm -rf dist && bun build ./src/cli.ts --outdir ./dist --target node",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "sharp": "^0.35.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
